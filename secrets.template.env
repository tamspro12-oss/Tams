# Custom Edge Function Secrets (set in Supabase Dashboard -> Edge Functions -> Secrets, or with: npx supabase secrets set NAME=value)

# (A) TAMS Pro System Email Secrets (used ONLY by send-system-email for official TAMS Pro emails)
SYSTEM_GMAIL_USER=tamspro12@gmail.com
SYSTEM_GMAIL_APP_PASSWORD=
SYSTEM_EMAIL_FROM_NAME=TAMS Pro

# (B) Agency Email Encryption Key (random 32+ char secret used by send-email to AES-256-GCM encrypt per-agency App Passwords)
AGENCY_EMAIL_ENCRYPTION_KEY=

# Existing Integration Secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_ORIGINS=https://tamspro.online
CRON_SECRET=
LOVABLE_API_KEY=

# Auto-provided by Supabase Edge Functions runtime (do not set manually; SUPABASE_* prefix is reserved)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
